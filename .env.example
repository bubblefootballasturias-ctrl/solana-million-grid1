# nft.storage API key (public token is used in frontend for store)
NEXT_PUBLIC_NFT_STORAGE_KEY=your_nft_storage_api_key

# Supabase (server side) - service role key required for server side insert
SUPABASE_URL=https://xyz.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Supabase anon key (solo lectura pública)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Wallet that will receive SOL payments
RECEIVER_PUBLIC_KEY=YourReceiverPublicKeyHere

# Network to use: devnet | mainnet-beta
NEXT_PUBLIC_NETWORK=devnet

# Price per square in SOL (para pruebas 0.01; cambia a 0.1 en producción)
NEXT_PUBLIC_PRICE_PER_SQUARE=0.01
